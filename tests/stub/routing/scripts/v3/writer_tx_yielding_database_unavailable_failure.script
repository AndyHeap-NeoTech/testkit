!: BOLT #VERSION#
!: AUTO HELLO
!: AUTO RESET

C: BEGIN {}
S: SUCCESS {}
C: RUN "RETURN 1 as n" {} {}
S: FAILURE {"code": "Neo.TransientError.General.DatabaseUnavailable", "message": "Database is busy doing store copy"}
{?
    # For drivers that pipeline RUN and PULL
    C: PULL_ALL
    S: IGNORED
?}
{?
    C: GOODBYE
    S: <EXIT>
?}
